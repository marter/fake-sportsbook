# Copy to deploy/.env.prod ON THE SERVER (never commit it).
# Generate secrets with: openssl rand -hex 32
SPORTSBOOK_HOST=sportsbook.martinteran.me
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
# Optional: without it, odds come from the bundled sample fixture.
ODDS_API_KEY=
# Optional: credits per month in your Odds API plan (default 500, the free plan). Shown on
# the admin page; raise it after upgrading.
# ODDS_API_MONTHLY_CREDITS=500
# Resend API key (a "sending access" key is enough) for verification emails.
RESEND_API_KEY=
# Optional: leagues to offer (default all). Leave one out to hide its tab, e.g. nfl,nba,mlb
# ENABLED_SPORTS=nfl,nba,mlb,wnba
# Optional: sign-ups close once this many accounts exist (default 5).
# MAX_USERS=5
