# Shared reverse proxy for every app on this server. Caddy gets and renews HTTPS
# certificates automatically once DNS points at the server.
#
# Each app joins the external "web" Docker network with unique aliases
# (e.g. sportsbook-backend), so Caddy can reach it by name.

{$SPORTSBOOK_HOST:sportsbook.martinteran.me} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy sportsbook-backend:8000
	}

	handle {
		reverse_proxy sportsbook-frontend:80
	}
}

volunteer.martinteran.me {
	encode zstd gzip
	handle /api/* {
		reverse_proxy volunteer-backend:8000
	}
	handle {
		reverse_proxy volunteer-frontend:80
	}
}

# Personal site: static files uploaded by the martinteran.me repo's deploy.sh.
martinteran.me {
	encode zstd gzip
	root * /srv/site
	file_server
	header Cache-Control "public, max-age=300"
}

www.martinteran.me {
	redir https://martinteran.me{uri} permanent
}
